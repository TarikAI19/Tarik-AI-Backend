DATABASE_URL=postgresql://user:password@localhost/tarik_db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# TTS — ElevenLabs (EN + AR audio). Only the API key is required.
ELEVENLABS_API_KEY=
# Optional — defaults to a built-in ElevenLabs voice if omitted
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_PROVIDER=elevenlabs
AUDIO_STORAGE_DIR=storage/audio

# Groq (EN + AR exhibit text)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Addis AI (Amharic + Afaan Oromo text + audio)
ADDIS_AI_API_KEY=
ADDIS_AI_BASE_URL=https://api.addisassistant.com/api/v1
# Optional voice overrides (defaults: am-hamen / om-bikila)
# ADDIS_TTS_VOICE_AM=am-hamen
# ADDIS_TTS_VOICE_OM=om-bikila

# Optional: visitor Q&A / other features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
